@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="MemonDoctor" content="" />
    <link rel="shortcut icon" href="Admin/images/favicon.png" type="">

    <title> Memon Doctor </title>

    @* <link rel="stylesheet" href="~/css/bootstrap.css" /> *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/Admin/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Admin/css/style.css" />
    <link rel="stylesheet" href="~/Admin/css/responsive.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />

    <!-- jQuery -->
    <script src="js/jquery-3.4.1.min.js"></script>

    <!-- Popper JS -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="js/bootstrap.js"></script>
    <!-- OR use CDN -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script> -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="js/custom.js"></script>

</head>

<body class="sub_page">

    <div class="hero_area">

        <div class="hero_bg_box">
            <img src="Admin/images/hero-bg.png" alt="">
        </div>

        <!-- header section strats -->
        <header class="header_section">
            <div class="container">
                <nav class="navbar navbar-expand-lg custom_nav-container ">
                    <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Admin")">
                        <img src="~/files/logo/logo.png" alt="Memon Doctor Logo"
                             style="height:40px; width:auto; margin-right:10px;">

                        <!-- Full title for medium and larger screens -->
                        <span class="d-none d-md-inline" style="font-size:22px; font-weight:bold; color:#fff;">
                            Gujarat Tharadi Memon Doctor Association
                        </span>

                        <!-- Short title for small screens -->
                        <span class="d-inline d-md-none" style="font-size:22px; font-weight:bold; color:#fff;">
                            GTMDA
                        </span>
                    </a>

                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class=""> </span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav">
                            <li class="nav-item active">
                                <a class="nav-link" href="@Url.Action("Index", "Admin")">Home <span class="sr-only">(current)</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Directory", "Admin")"> Directory</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Admin")">Login</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </header>
        <!-- end header section -->
        <!-- slider section -->
        <section class="search_section" style="background: linear-gradient(to bottom, #53a0d8, #ffffff); padding: 60px 0;">
            <div class="container">
                <!-- Search Box -->
                <div class="row justify-content-center mb-4">
                    <div class="col-md-8">
                        <div class="input-group shadow-sm">
                            <input type="text" id="searchBox" class="form-control" placeholder="Search by Email, Mobile or Address..." style="border: 2px solid #53a0d8;">
                            <div class="input-group-append">
                                <span class="input-group-text" style="background-color:#53a0d8; color:white; font-weight:bold;">🔍</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive shadow-sm">
                            <table class="table table-bordered table-striped text-center" style="background:white;">
                                <thead style="background:#53a0d8; color:white;">
                                    <tr>
                                        <th>No</th>
                                        <th>Email</th>
                                        <th>Mobile Number</th>
                                        <th>Clinic Address</th>
                                    </tr>
                                </thead>
                                <tbody id="dataTable">
                                    <tr>
                                        <td>1</td>
                                        <td>doctor1@example.com</td>
                                        <td>9876543210</td>
                                        <td>Main Street, City</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>doctor2@example.com</td>
                                        <td>9876501234</td>
                                        <td>Health Road, Town</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>doctor3@example.com</td>
                                        <td>9123456789</td>
                                        <td>Wellness Plaza, Metro</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
    <footer class="footer_section" style="background:#53a0d8; color:#ffffff; padding:50px 0 0; font-family:Arial, sans-serif;">
        <div class="container">
            <div class="row justify-content-center">

                <!-- About Section -->
                <div class="col-md-6 col-lg-5 footer_col mb-0">
                    <h2 style="text-align:center; font-size:34px; font-weight:bold; color:#FFF; margin-bottom:15px;">
                        About Us
                    </h2>
                    <p style="text-align:center; font-size:15px; line-height:1.8; opacity:0.9;">
                        Our mission is to simplify your search for quality healthcare.
                        We provide accurate, up-to-date information on doctors and clinics,
                        helping you make informed decisions about your well-being with confidence.
                    </p>
                </div>

                <!-- Contact + Social -->
                <div class="col-md-6 col-lg-5 footer_col mb-0">
                    <h2 style="text-align:center; font-size:34px; font-weight:bold; color:#fff; margin-bottom:15px;">
                        Get in Touch
                    </h2>
                    <p style="text-align:center; margin-bottom:15px; font-size:15px; line-height:1.8;">
                        📍 123 Health Street, Your City<br>
                        📞 +91 9876543210<br>
                        📧 info@yourdomain.com
                    </p>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div style="background:#3c8dc2; padding:10px 0; margin-top:40px;">
            <div class="container d-flex justify-content-between align-items-center">
                <div style="font-size:14px;">© 2025 Developed by <strong>Sumer Memon</strong></div>
                <div style="font-size:14px;">📞 +91 9974751411</div>
            </div>
        </div>
    </footer>
</body>

</html>



<!-- jQuery for Live Search -->
<script>
    $(document).ready(function () {
        $("#searchBox").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#dataTable tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>

<!-- end slider section -->