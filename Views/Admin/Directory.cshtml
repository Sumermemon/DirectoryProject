    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="MemonDoctor" content="" />
    <link rel="shortcut icon" href="Admin/images/favicon.png" type="">

    <title> GTMDA </title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="~/Admin/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Admin/css/style.css" />
    <link rel="stylesheet" href="~/Admin/css/responsive.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Popper JS -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>
    <!-- Owl -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js"></script>
    <script src="js/custom.js"></script>
</head>

<body class="sub_page">

    <div class="hero_area">
        <div class="hero_bg_box">
            <img src="Admin/images/hero-bg.png" alt="">
        </div>

        <!-- header section strats -->
        <header class="header_section">
            <div class="container">
                <nav class="navbar navbar-expand-lg custom_nav-container ">
                    <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Admin")">
                        <img src="~/files/logo/logo.png" alt="Memon Doctor Logo"
                             style="height:40px; width:auto; margin-right:10px;">

                        <!-- Full title for medium and larger screens -->
                        <span class="d-none d-md-inline" style="font-size:22px; font-weight:bold; color:#fff;">
                            Gujarat Tharadi Memon Doctor Association
                        </span>

                        <!-- Short title for small screens -->
                        <span class="d-inline d-md-none" style="font-size:22px; font-weight:bold; color:#fff;">
                            GTMDA
                        </span>
                    </a>

                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class=""> </span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav">
                            <li class="nav-item active">
                                <a class="nav-link" href="@Url.Action("Index", "Admin")">Home <span class="sr-only">(current)</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Directory", "Admin")"> Directory</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Admin")">Login</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </header>
        <!-- end header section -->
        <!-- search + table section -->
        <section class="search_section" style="background: linear-gradient(to bottom, #53a0d8, #ffffff); padding: 60px 0;">
            <div class="container">
                <!-- Search Box -->
                <div class="row justify-content-center mb-4">
                    <div class="col-md-8">
                        <div class="input-group shadow-sm">
                            <input type="text" id="searchBox" class="form-control" placeholder="Search by Name, Qualification or Address..." style="border: 2px solid #53a0d8;">
                            <div class="input-group-append">
                                <span class="input-group-text" style="background-color:#53a0d8; color:white; font-weight:bold;">🔍</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive shadow-sm">
                            <table class="table table-bordered table-striped text-center" style="background:white;">
                                <thead style="background:#53a0d8; color:white;">
                                    <tr>
                                        <th>No</th>
                                        <th>Name</th>
                                        <th>Qualification</th>
                                        <th>Address</th>
                                    </tr>
                                </thead>
                                <tbody id="dataTable"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Page Size & Pagination -->
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-3">
                    <div>
                        <label>
                            Show
                            <select id="pageSize" class="custom-select" style="width:auto; display:inline-block;">
                                <option value="10" selected>10</option>
                                <option value="20">20</option>
                                <option value="30">30</option>
                                <option value="50">50</option>
                            </select> entries
                        </label>
                    </div>

                    <nav>
                        <ul class="pagination" id="pagination"></ul>
                    </nav>
                </div>

                <!-- Info -->
                <div class="mt-2" id="tableInfo" style="font-size:14px; color:#333;"></div>
            </div>
        </section>
    </div>

    <!-- Footer -->
    <footer class="footer_section" style="background:#53a0d8; color:#ffffff; padding:50px 0 0; font-family:Arial, sans-serif;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5 footer_col mb-0">
                    <h2 style="text-align:center; font-size:34px; font-weight:bold; color:#FFF; margin-bottom:15px;">
                        About Us
                    </h2>
                    <p style="text-align:center; font-size:15px; line-height:1.8; opacity:0.9;">
                        Our mission is to simplify your search for quality healthcare.
                        We provide accurate, up-to-date information on doctors and clinics,
                        helping you make informed decisions about your well-being with confidence.
                    </p>
                </div>
                <div class="col-md-6 col-lg-5 footer_col mb-0">
                    <h2 style="text-align:center; font-size:34px; font-weight:bold; color:#fff; margin-bottom:15px;">
                        GTMDA HELPLINE
                    </h2>
                    <p style="text-align:center; margin-bottom:15px; font-size:15px; line-height:1.8;">
                        📞 +91 9601701318<br>
                        📧 info.gtmda@gmail.com
                    </p>
                </div>
            </div>
        </div>

        <div style="background:#3c8dc2; padding:10px 0; margin-top:40px;">
            <div class="container d-flex justify-content-between align-items-center">
                <div style="font-size:14px;">© 2025 Developed by <strong>Sumer Memon</strong></div>
                <div style="font-size:14px;">📞 +91 9638797887</div>
            </div>
        </div>
    </footer>
</body>
</html>

<script>
    $(document).ready(function () {
        let allData = [];
        let filteredData = [];
        let currentPage = 1;
        let rowsPerPage = 10;

        // Fetch all data
        $.ajax({
            url: '/Admin/GetAllDirectory',
            method: 'GET',
            success: function (response) {
                if (response && response.data) {
                    allData = response.data;
                    filteredData = [...allData];
                    renderTable();
                    renderPagination();
                }
            },
            error: function () {
                alert("Failed to load directory data.");
            }
        });

        function renderTable() {
            const tbody = $("#dataTable");
            tbody.empty();

            const start = (currentPage - 1) * rowsPerPage;
            const end = start + rowsPerPage;
            const pageData = filteredData.slice(start, end);

            if (pageData.length === 0) {
                tbody.append(`<tr><td colspan="4">No records found</td></tr>`);
                $("#tableInfo").text("No records available");
                return;
            }

            pageData.forEach((item, index) => {
                tbody.append(`
                    <tr>
                        <td>${start + index + 1}</td>
                        <td>${item.name || ''}</td>
                        <td>${item.qualification || ''}</td>
                        <td>${item.address || ''}</td>
                    </tr>
                `);
            });

            $("#tableInfo").text(`Showing ${start + 1} to ${Math.min(end, filteredData.length)} of ${filteredData.length} entries`);
        }

            function renderPagination() {
        const totalPages = Math.ceil(filteredData.length / rowsPerPage);
        const pagination = $("#pagination");
        pagination.empty();

        if (totalPages <= 1) return;

        // Determine how many page buttons to show based on screen size
        let maxVisiblePages;
        if (window.innerWidth < 576) maxVisiblePages = 3;      // mobile
        else if (window.innerWidth < 768) maxVisiblePages = 5; // tablet
        else maxVisiblePages = 9;                              // desktop

        pagination.append(`<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                              <a class="page-link" href="#">Prev</a>
                           </li>`);

        let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
        let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

        // Adjust if we’re near the end
        if (endPage - startPage + 1 < maxVisiblePages) {
            startPage = Math.max(1, endPage - maxVisiblePages + 1);
        }

        // Add ellipsis if needed
        if (startPage > 1) {
            pagination.append(`<li class="page-item"><a class="page-link" href="#">1</a></li>`);
            if (startPage > 2)
                pagination.append(`<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`);
        }

        for (let i = startPage; i <= endPage; i++) {
            pagination.append(`<li class="page-item ${i === currentPage ? 'active' : ''}">
                                  <a class="page-link" href="#">${i}</a>
                               </li>`);
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1)
                pagination.append(`<li class="page-item disabled"><a class="page-link" href="#">...</a></li>`);
            pagination.append(`<li class="page-item"><a class="page-link" href="#">${totalPages}</a></li>`);
        }

        pagination.append(`<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                              <a class="page-link" href="#">Next</a>
                           </li>`);
    }


        $(document).on("click", "#pagination .page-link", function (e) {
            e.preventDefault();
            const text = $(this).text();

            if (text === "Prev" && currentPage > 1) {
                currentPage--;
            } else if (text === "Next" && currentPage < Math.ceil(filteredData.length / rowsPerPage)) {
                currentPage++;
            } else if (!isNaN(parseInt(text))) {
                currentPage = parseInt(text);
            }

            renderTable();
            renderPagination();
        });

        $("#searchBox").on("keyup", function () {
            const value = $(this).val().toLowerCase();
            filteredData = allData.filter(item =>
                (item.name && item.name.toLowerCase().includes(value)) ||
                (item.qualification && item.qualification.toLowerCase().includes(value)) ||
                (item.address && item.address.toLowerCase().includes(value))
            );
            currentPage = 1;
            renderTable();
            renderPagination();
        });

        $("#pageSize").on("change", function () {
            rowsPerPage = parseInt($(this).val());
            currentPage = 1;
            renderTable();
            renderPagination();
        });
    });
</script>
