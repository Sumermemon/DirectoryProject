@using DirectoryProject.Entity
@model ResponseModel<List<UsersMasters>>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</head>
<style>
    /* Hover effect for table rows */
    #userTable tbody tr:hover {
        background-color: #e3f2fd;
    }

    /* User photo in table */
    #userTable tbody img {
        width: 40px;
        height: 40px;
        object-fit: cover;
        border-radius: 50%;
        border: 1px solid #ddd;
    }

    /* Table header bold */
    #userTable thead th {
        font-weight: 600;
        text-align: center;
    }

    /* Table body center align */
    #userTable tbody td {
        vertical-align: middle;
        text-align: center;
    }

    /* Action buttons styling */
    #userTable .btn {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .validation-error {
        font-size: 0.8rem;
    }
</style>
<body class="bg-light">

    <div class="container mt-5">
        <div class="card shadow rounded-3">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

                <!-- Left Buttons -->
                <div class="d-flex gap-2">
                    <a href="/Admin/Index" class="btn btn-sm btn-light text-primary fw-bold">
                        <i class="fas fa-home me-1"></i> Home
                    </a>
                    <a href="/Admin/PageDirectory" class="btn btn-sm btn-light text-primary fw-bold">
                        <i class="fas fa-folder-open me-1"></i> Directory
                    </a>
                </div>

                <!-- Title and Add Button (Right Side) -->
                <div class="d-flex align-items-center gap-3">
                    <h4 class="mb-0">User Management</h4>
                    <button class="btn btn-sm btn-light text-primary fw-bold" onclick="openUserModal()">
                        <i class="fas fa-plus me-1"></i> Add User
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle" id="userTable">
                        <thead class="table-primary text-dark">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Name</th>
                                <th scope="col">Email</th>
                                <th scope="col">Mobile</th>
                                <th scope="col">DOB</th>
                                <th scope="col">Qualification</th>
                                <th scope="col">RegNo</th>
                                <th scope="col">GTMDANo</th>
                                <th scope="col">Photo</th>
                                <th scope="col">Admin</th>
                                <th scope="col">Active</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Success && Model.data is not null)
                            {
                                @for (int i = 0; i < Model.data.Count; i++)
                                {
                                    var user = Model.data[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@user.Name</td>
                                        <td>@user.Email</td>
                                        <td>@user.MobileNo</td>
                                        <td>@user.DOB</td>
                                        <td>@user.Qualification</td>
                                        <td>@user.RegNo</td>
                                        <td>@user.GTMDANo</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(user.ProfilePhoto))
                                            {
                                                <img src="@user.ProfilePhoto" style="width:50px; height:50px; object-fit:cover; border-radius:50%;" />
                                            }
                                            else
                                            {
                                                <span>No Photo</span>
                                            }
                                        </td>
                                        <td style="@(user.IsAdmin ? "color:green" : "color:red")">@(user.IsAdmin ? "Yes" : "No")</td>
                                        <td style="@(user.IsActive ? "color:green" : "color:red")">@(user.IsActive ? "Yes" : "No")</td>
                                        <td>
                                            <button class="btn btn-sm btn-info" onclick="editUser(@user.Id)">Edit</button>
                                            <button class="btn btn-sm btn-danger" onclick="deleteUser(@user.Id)">Delete</button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center text-danger">No users found.</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- User Modal -->
    <div class="modal fade" id="userModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header text-white" style="background-color:#53a0d8;">
                    <h5 class="modal-title" id="modalTitle">Add User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="userForm">
                        <input type="hidden" id="UserId" />
                        <div class="row">
                            <div class="mb-3 col-md-6">
                                <label>Name <span class="text-danger">*</span></label>
                                <input type="text" id="Name" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>Email <span class="text-danger">*</span></label>
                                <input type="email" id="Email" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>Mobile No <span class="text-danger">*</span></label>
                                <input type="text" id="MobileNo" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>DOB <span class="text-danger">*</span></label>
                                <input type="date" id="DOB" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>Qualification <span class="text-danger">*</span></label>
                                <input type="text" id="Qualification" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>RegNo <span class="text-danger">*</span></label>
                                <input type="text" id="RegNo" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>GTMDANo <span class="text-danger">*</span></label>
                                <input type="text" id="GTMDANo" class="form-control" required />
                            </div>
                            <div class="mb-3 col-md-6">
                                <label>Profile Photo</label>
                                <input type="file" id="ProfilePhoto" class="form-control" accept="image/*" />
                                <img id="previewPhoto" src="" alt="" class="mt-2" style="width:150px; display:none;" />
                                <div id="currentPhoto" class="mt-1" style="display:none;">
                                    <small class="text-muted">Current Photo:</small>
                                    <img id="currentPhotoImg" src="" style="width:50px; height:50px; object-fit:cover; border-radius:50%;" />
                                </div>
                            </div>
                            <div class="mb-3 col-md-6 form-check mt-4">
                                <input type="checkbox" id="IsAdmin" class="form-check-input" />
                                <label class="form-check-label">Is Admin</label>
                            </div>
                            <div class="mb-3 col-md-6 form-check mt-4">
                                <input type="checkbox" id="IsActive" class="form-check-input" checked />
                                <label class="form-check-label">Is Active</label>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" onclick="saveUser()" style="background-color:#53a0d8;">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Photo preview functionality
        document.getElementById("ProfilePhoto").addEventListener("change", function(event) {
            var file = event.target.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    var img = document.getElementById("previewPhoto");
                    img.src = e.target.result;
                    img.style.display = "block";
                    // Hide current photo when new one is selected
                    $("#currentPhoto").hide();
                }
                reader.readAsDataURL(file);
            }
        });

        function openUserModal() {
            $("#UserId").val("");
            $("#userForm")[0].reset();
            $("#previewPhoto").hide();
            $("#currentPhoto").hide();
            $("#modalTitle").text("Add User");
            $("#IsActive").prop("checked", true);
            $("#IsAdmin").prop("checked", false);
            $(".validation-error").remove();
            $("#userModal").modal("show");
        }

        function editUser(id) {
            debugger
            $.post("/Admin/GetUserbyId", { Id: id }, function(res) {
                if (res.success) {
                    let u = res.data;
                    $("#UserId").val(u.id);
                    $("#Name").val(u.name);
                    $("#Email").val(u.email);
                    $("#MobileNo").val(u.mobileNo);
                    if(u.dob != undefined && u.dob != null){
                        $("#DOB").val(u.dob.split('T')[0]); // Format date for input
                    }
                    $("#Qualification").val(u.qualification);
                    $("#RegNo").val(u.regNo);
                    $("#GTMDANo").val(u.gtmdaNo);

                    // Handle photo display
                    $("#previewPhoto").hide();
                    if (u.profilePhoto) {
                        $("#currentPhotoImg").attr("src", u.profilePhoto);
                        $("#currentPhoto").show();
                    } else {
                        $("#currentPhoto").hide();
                    }

                    $("#IsActive").prop("checked", u.isActive);
                    $("#IsAdmin").prop("checked", u.isAdmin);
                    $("#modalTitle").text("Edit User");
                    $(".validation-error").remove();
                    $("#userModal").modal("show");
                } else {
                    alert(res.message || "User not found");
                }
            }).fail(function() {
                alert("Error fetching user data");
            });
        }

        function saveUser() {
            $(".validation-error").remove();

            let isValid = true;

            // Required fields validation
            const requiredFields = ["Name", "Email", "MobileNo", "DOB", "Qualification", "RegNo", "GTMDANo"];
            requiredFields.forEach(function(field) {
                if (!$("#" + field).val().trim()) {
                    isValid = false;
                    $("#" + field).after('<span class="validation-error text-white bg-danger p-1 rounded mt-1 d-block">This field is required</span>');
                }
            });

            if (!isValid) return;

            let formData = new FormData();
            formData.append("Id", $("#UserId").val() || 0);
            formData.append("Name", $("#Name").val());
            formData.append("Email", $("#Email").val());
            formData.append("MobileNo", $("#MobileNo").val());
            formData.append("DOB", $("#DOB").val());
            formData.append("Qualification", $("#Qualification").val());
            formData.append("RegNo", $("#RegNo").val());
            formData.append("GTMDANo", $("#GTMDANo").val());
            formData.append("IsActive", $("#IsActive").is(":checked"));
            formData.append("IsAdmin", $("#IsAdmin").is(":checked"));

            // Append file if selected
            if ($("#ProfilePhoto")[0].files.length > 0) {
                formData.append("file", $("#ProfilePhoto")[0].files[0]);
            }

            $.ajax({
                url: "/Admin/CreateUser",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function(res) {
                    if (res.success) {
                        $("#userModal").modal("hide");
                        alert("User saved successfully!");
                        // Reload the page to see changes
                        setTimeout(function() {
                            location.reload();
                        }, 1000);
                    } else {
                        alert(res.message || "Something went wrong");
                    }
                },
                error: function() {
                    alert("Error saving user");
                }
            });
        }

        function deleteUser(id) {
            if (confirm("Are you sure you want to delete this user?")) {
                $.post("/Admin/DeleteUserById", { id: id }, function(res) {
                    if (res.success) {
                        alert("User deleted successfully!");
                        location.reload();
                    } else {
                        alert(res.message || "Delete failed");
                    }
                }).fail(function() {
                    alert("Error deleting user");
                });
            }
        }

        // Page reload function (if you want to use AJAX reload instead of full page reload)
        function loadUsers() {
            location.reload();
        }
    </script>
</body>
</html>