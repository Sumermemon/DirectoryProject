<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login with OTP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background: linear-gradient(to bottom right, #53a0d8, #ffffff);
            font-family: 'Roboto', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .login-box {
            max-width: 400px;
            margin: 80px auto;
            background: #fff;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0px 8px 25px rgba(0,0,0,0.15);
        }

            .login-box h2 {
                text-align: center;
                margin-bottom: 25px;
                color: #53a0d8;
                font-weight: bold;
            }

        .otp-input {
            width: 55px;
            height: 55px;
            text-align: center;
            font-size: 22px;
            margin: 0 5px;
            border: 2px solid #53a0d8;
            border-radius: 8px;
            outline: none;
            transition: 0.3s;
        }

            .otp-input:focus {
                border-color: #2d77b8;
                box-shadow: 0px 0px 8px rgba(83,160,216,0.6);
            }

        .btn-custom {
            background-color: #53a0d8;
            color: #fff;
            font-weight: bold;
            border-radius: 8px;
            transition: 0.3s;
        }

            .btn-custom:hover {
                background-color: #2d77b8;
            }

        .otp-box {
            display: none;
            text-align: center;
            margin-top: 20px;
        }

        #adminChoiceModal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .resend-btn {
            background: none;
            border: none;
            color: #007bff;
            cursor: pointer;
            text-decoration: underline;
        }

            .resend-btn:disabled {
                color: #6c757d;
                cursor: not-allowed;
                text-decoration: none;
            }
    </style>
</head>
<body>

    <div class="login-box">
        <h2>Login</h2>
        <!-- Email Section -->
        <div id="emailSection">
            <div class="form-group">
                <label for="email">Enter your Email</label>
                <input type="email" id="email" class="form-control" placeholder="example@email.com">
            </div>
            <button class="btn btn-custom btn-block" onclick="showOtp()">Send OTP</button>
        </div>

        <!-- OTP Section -->
        <div id="otpSection" class="otp-box">
            <h5>Enter OTP</h5>
            <div class="d-flex justify-content-center">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 'otp2')" id="otp1">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 'otp3')" id="otp2">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, 'otp4')" id="otp3">
                <input type="text" maxlength="1" class="otp-input" oninput="moveNext(this, '')" id="otp4">
            </div>
            <button class="btn btn-custom btn-block mt-3" onclick="verifyOtp()">Verify OTP</button>
            <div class="mt-2">
                <button id="resendBtn" class="resend-btn" onclick="sendOtp()" disabled>Resend OTP</button>
                <span id="timerText" class="ml-2 text-muted"></span>
            </div>
        </div>
    </div>

    <!-- Admin Choice Modal -->
    <div id="adminChoiceModal">
        <div style="background: white;
                padding: 30px;
                border-radius: 10px;
                text-align: center;
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
                max-width: 400px;
                width: 90%;">
            <h3 style="margin-bottom: 20px; color: #333;">Admin Login Successful</h3>
            <p style="margin-bottom: 25px; color: #666;">What would you like to do?</p>
            <div style="display: flex; gap: 15px; justify-content: center;">
                <button onclick="selectAdminOption('idcard')" style="
                        padding: 12px 24px;
                        background: #007bff;
                        color: white;
                        border: none;
                        border-radius: 5px;
                        cursor: pointer;
                        font-size: 14px;">
                    Show ID Card
                </button>
                <button onclick="selectAdminOption('admin')" style="
                        padding: 12px 24px;
                        background: #28a745;
                        color: white;
                        border: none;
                        border-radius: 5px;
                        cursor: pointer;
                        font-size: 14px;">
                    Admin Panel
                </button>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        let countdownInterval;

        function showOtp() {
            let email = $("#email").val();
            if (!email) {
                return alert("Enter Email");
            } else {
                document.getElementById("emailSection").style.display = "none";
                document.getElementById("otpSection").style.display = "block";
                sendOtp();
            }
        }

        function moveNext(current, nextId) {
            if (current.value.length == 1 && nextId) {
                document.getElementById(nextId).focus();
            }
        }

        function sendOtp() {
            let email = $("#email").val();
            if (!email) {
                return alert("Enter Email");
            } else {
                $.post("/Account/SendOtp", { email: email }, function (res) {
                    if (res.success) {
                        alert("OTP sent to your email!");
                        $("#emailSection").hide();
                        $("#otpSection").show();
                        startTimer(300); // start 5-minute timer (300 seconds)
                    } else {
                        alert(res.message || "Error sending OTP");
                        document.getElementById("emailSection").style.display = "block";
                        document.getElementById("otpSection").style.display = "none";
                    }
                }).fail(function() {
                    alert("Error sending OTP. Please try again.");
                    document.getElementById("emailSection").style.display = "block";
                    document.getElementById("otpSection").style.display = "none";
                });
            }
        }

        function verifyOtp() {
            let otp = $("#otp1").val() + $("#otp2").val() + $("#otp3").val() + $("#otp4").val();
            let email = $("#email").val();

            // Basic OTP validation
            if (otp.length !== 4) {
                return alert("Please enter a complete 4-digit OTP");
            }

            $.post("/Account/VerifyOtp", { email: email, otp: otp }, function (res) {
                if (res.success) {
                    if (res.isAdmin) {
                        // Show custom modal for admin choice
                        $('#adminChoiceModal').css('display', 'flex');
                    } else {
                        alert("Login successful!");
                        window.location.href = "/Admin/CardPanel";
                    }
                } else {
                    alert(res.message || "Invalid OTP");
                }
            }).fail(function() {
                alert("Error verifying OTP. Please try again.");
            });
        }

        function selectAdminOption(choice) {
            // Hide the modal
            $('#adminChoiceModal').hide();

            // Redirect based on choice
            if (choice === 'idcard') {
                window.location.href = "/Admin/CardPanel";
            } else if (choice === 'admin') {
                window.location.href = "/Admin/Users";
            }
        }

        function startTimer(duration) {
            let timer = duration;
            $("#resendBtn").prop("disabled", true);
            $("#timerText").text(formatTime(timer));

            clearInterval(countdownInterval);
            countdownInterval = setInterval(() => {
                timer--;
                $("#timerText").text(formatTime(timer));

                if (timer <= 0) {
                    clearInterval(countdownInterval);
                    $("#timerText").text("");
                    $("#resendBtn").prop("disabled", false);
                }
            }, 1000);
        }

        function formatTime(seconds) {
            let minutes = Math.floor(seconds / 60);
            let sec = seconds % 60;
            return `(${minutes}:${sec < 10 ? "0" + sec : sec})`;
        }

        // Allow Enter key to submit OTP
        $(document).ready(function() {
            $('#otp4').keypress(function(e) {
                if (e.which == 13) { // Enter key
                    verifyOtp();
                }
            });
        });
    </script>

</body>
</html>