@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <!-- Basic -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- Mobile Metas -->
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Site Metas -->
    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="MemonDoctor" content="" />
    <link rel="shortcut icon" href="Admin/images/favicon.png" type="">

    <title> GTMDA </title>

    <!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Popper.js -->
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>

    <!-- bootstrap core css -->
    <link rel="stylesheet" type="text/css" href="Admin/css/bootstrap.css" />

    <!-- fonts style -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">

    <!--owl slider stylesheet -->
    <link rel="stylesheet" type="Admin/text/css" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />

    <!-- font awesome style -->
    <link href="Admin/css/font-awesome.min.css" rel="stylesheet" />

    <!-- Custom styles for this template -->
    <link href="Admin/css/style.css" rel="stylesheet" />
    <!-- responsive style -->
    <link href="Admin/css/responsive.css" rel="stylesheet" />

</head>

<body>

    <div class="hero_area">

        <div class="hero_bg_box">
            <img src="Admin/images/hero-bg.png" alt="">
        </div>

        <!-- header section strats -->
        <header class="header_section">
            <div class="container">
                <nav class="navbar navbar-expand-lg custom_nav-container ">
                    <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index", "Admin")">
                        <img src="~/files/logo/logo.png" alt="Memon Doctor Logo"
                             style="height:40px; width:auto; margin-right:10px;">

                        <!-- Full title for medium and larger screens -->
                        <span class="d-none d-md-inline" style="font-size:22px; font-weight:bold; color:#fff;">
                            Gujarat Tharadi Memon Doctor Association
                        </span>

                        <!-- Short title for small screens -->
                        <span class="d-inline d-md-none" style="font-size:22px; font-weight:bold; color:#fff;">
                            GTMDA
                        </span>
                    </a>

                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class=""> </span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav">
                            <li class="nav-item active">
                                <a class="nav-link" href="@Url.Action("Index", "Admin")">Home <span class="sr-only">(current)</span></a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Directory", "Admin")"> Directory</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Login", "Admin")">Login</a>
                            </li>
                        </ul>
                    </div>
                </nav>
            </div>
        </header>
        <!-- end header section -->
        <!-- slider section -->
        <section class="slider_section ">
            <div id="customCarousel1" class="carousel slide" data-ride="carousel">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <div class="container ">
                            <div class="row">
                                <div class="col-md-7">
                                    <div class="detail-box">
                                        <h1>
                                            We Provide Best Healthcare
                                        </h1>
                                        <p>
                                            Find and book appointments with trusted healthcare professionals in your area. Browse detailed profiles, contact information, and clinic addresses to find the right doctor for your needs.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- end slider section -->

    </div>
    <!-- about section -->

    <section class="about_section layout_margin-bottom">
        <div class="container  ">
            <div class="row">
                <div class="col-md-6 ">
                    <div class="img-box">
                        <img src="Admin/images/ImageDRImran.jpg" alt="">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="heading_container">
                            <h2>
                                Our <span>President</span>
                            </h2>
                        </div>
                        <p>
                            થરાદી મેમણ સમાજના ગૌરવ , યુથ આઈકોન, ઓલ ઇન્ડિયા મેમણ જમાત ફેડરેશન 
                            <span style="font-weight:bold">(AIMJF)</span>
                            ના <b>Coordinator – Youth Wing Doctors Panel (All India Level)</b> તથા <b>થરાદી મેમણ ડોક્ટર એસોસિએશનના પ્રમુખ(GTMDA)</b>  તથા સમાજના લોકલાડીલા <b>હાફિઝ ડૉ. ઇમરાન અબ્દુલ કાદર પીપલાવાલા (ડાયાબિટીસ સ્પેશિયાલિસ્ટ)</b>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="about_section layout_margin-bottom" style="padding: 80px 0; background: #f8f9fa;">
        <div class="container">
            <div class="row align-items-center">

                <!-- Video Section -->
                <div class="col-md-6 mb-4 mb-md-0">
                    <div class="embed-responsive embed-responsive-16by9 shadow rounded overflow-hidden">
                        <video class="embed-responsive-item" src="Admin/video/GTMDA-Video.mp4" autoplay muted loop controls></video>
                    </div>
                </div>

                <!-- Text Section -->
                <div class="col-md-6">
                    <div class="detail-box">
                        <div class="heading_container mb-4">
                            <h2 style="font-weight:700; font-size:36px; color:#333;">
                                Our <span style="color:#53a0d8;">Plans</span>
                            </h2>
                            <p style="color:#555; font-size:16px; line-height:1.8; margin-top:15px;">
                                At <strong>GTMDA</strong>, we aim to bring doctors and healthcare
                                professionals under one platform for better connectivity,
                                guidance, and support. Our plans are designed to create a
                                healthier community by offering:
                            </p>
                        </div>

                        <!-- Bullet Points -->
                        <ul style="list-style:none; padding:0; font-size:16px; line-height:1.8; color:#444;">
                            <li>✅ Building a strong doctor directory</li>
                            <li>✅ Organizing health awareness programs</li>
                            <li>✅ Providing networking opportunities</li>
                            <li>✅ Promoting medical research & innovation</li>
                        </ul>

                    </div>
                </div>

            </div>
        </div>
    </section>


    <!-- end about section -->


    <!-- footer section -->
    <footer class="footer_section" style="background:#53a0d8; color:#ffffff; padding:50px 0 0; font-family:Arial, sans-serif;">
        <div class="container">
            <div class="row justify-content-center">

                <!-- About Section -->
                <div class="col-md-6 col-lg-5 footer_col mb-0">
                    <h2 style="text-align:center; font-size:34px; font-weight:bold; color:#FFF; margin-bottom:15px;">
                        About Us
                    </h2>
                    <p style="text-align:center; font-size:15px; line-height:1.8; opacity:0.9;">
                        Our mission is to simplify your search for quality healthcare.
                        We provide accurate, up-to-date information on doctors and clinics,
                        helping you make informed decisions about your well-being with confidence.
                    </p>
                </div>

                <!-- Contact + Social -->
                <div class="col-md-6 col-lg-5 footer_col mb-0">
                    <h2 style="text-align:center; font-size:34px; font-weight:bold; color:#fff; margin-bottom:15px;">
                        GTMDA HELPLINE
                    </h2>
                    <p style="text-align:center; margin-bottom:15px; font-size:15px; line-height:1.8;">
                        @* Bu Consultancy<br> *@
                        📞 +91 9601701318<br>
                        📧 info.memondoctors@gmail.com
                    </p>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div style="background:#3c8dc2; padding:10px 0; margin-top:40px;">
            <div class="container d-flex justify-content-between align-items-center">
                <div style="font-size:14px;">© 2025 Developed by <strong>Sumer Memon</strong></div>
                <div style="font-size:14px;">📞 +91 9974751411</div>
            </div>
        </div>
    </footer>


    <!-- footer section -->
    <!-- jQery -->
    <script type="Admin/text/javascript" src="js/jquery-3.4.1.min.js"></script>
    <!-- popper js -->
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous">
    </script>
    <!-- bootstrap js -->
    <script type="Admin/text/javascript" src="js/bootstrap.js"></script>
    <!-- owl slider -->
    <script type="Admin/text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js">
    </script>
    <!-- custom js -->
    <script type="Admin/text/javascript" src="js/custom.js"></script>

</body>

</html>